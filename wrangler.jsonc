{
  // Cloudflare Workers static-assets deploy. `pnpm build` writes the app to apps/web/dist/client.
  "name": "betterbukidnon",
  "compatibility_date": "2026-10-23",
  "assets": {
    "directory": "./apps/web/dist/client",
    // Pages are prerendered as folder/index.html. drop-trailing-slash serves them at
    // /services/health (the legacy and canonical form) and redirects /services/health/ there.
    "html_handling": "drop-trailing-slash",
    // Unknown paths get apps/web/dist/client/404.html with a 404 status
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  },
  // Required by `npx wrangler preview`, which Workers Builds runs for non-production branches
  "previews": {},
  // Serve previews on *.workers.dev (Cloudflare adds X-Robots-Tag: noindex there).
  // workers.dev is disabled for production, so preview URLs stay off unless set here.
  "preview_urls": true,
  // Custom domains are managed here, not in the dashboard. Each deploy sets that
  // Worker's custom domains to the list for its environment.
  "routes": [
    { "pattern": "dev.betterbukidnon.org", "custom_domain": true }
  ],

  // The top level above is the development Worker "betterbukidnon" (branch: develop).
  // `npx wrangler deploy --env production` deploys the Worker "betterbukidnon-production"
  // (branch: main). It inherits assets, compatibility_date and observability.
  "env": {
    "production": {
      // No branch previews on production; the development Worker handles those.
      "preview_urls": false,
      // Must be set here: without it, production would inherit dev.betterbukidnon.org.
      "routes": [
        { "pattern": "betterbukidnon.org", "custom_domain": true }
      ]
    }
  }
}
