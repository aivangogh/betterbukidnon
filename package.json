{
  "name": "betterbukidnon-web",
  "version": "2.0.0",
  "description": "BetterBukidnon.org - volunteer civic portal for the Province of Bukidnon",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "python3 -m http.server 8000",
    "build": "bash build.sh",
    "build:major": "bash scripts/version.sh major && bash build.sh --no-bump",
    "build:minor": "bash scripts/version.sh minor && bash build.sh --no-bump",
    "serve": "python3 -m http.server 8000",
    "serve:dist": "cd dist && python3 -m http.server 8080",
    "version:major": "node scripts/bump-version.js major",
    "version:minor": "node scripts/bump-version.js minor",
    "version:patch": "node scripts/bump-version.js patch",
    "version:check": "node scripts/bump-version.js",
    "test": "playwright test",
    "test:chrome": "playwright test --project=chrome",
    "test:report": "playwright show-report",
    "lighthouse": "lhci autorun",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "web:dev": "cd apps/web && vp dev",
    "web:build": "cd apps/web && vp build",
    "web:preview": "cd apps/web && vp preview",
    "web:typecheck": "vp check --no-fmt --no-lint apps/web",
    "web:check": "vp check apps/web",
    "web:test": "vp test run apps/web/src",
    "package": "bash scripts/package-cpanel.sh --build",
    "package:only": "bash scripts/package-cpanel.sh"
  },
  "keywords": [
    "bukidnon",
    "northern-mindanao",
    "province",
    "government",
    "lgu"
  ],
  "author": "BetterBukidnon contributors",
  "contributors": [
    "Ramon Logan Jr. (original BetterSolano template)"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/DMNCDLPRT/betterbukidnon.git"
  },
  "homepage": "https://betterbukidnon.org",
  "license": "MIT",
  "devDependencies": {
    "@babel/cli": "^7.23.9",
    "@babel/core": "^7.29.6",
    "@babel/preset-env": "^7.23.9",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.61.0",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "clean-css-cli": "^5.6.3",
    "core-js": "^3.40.0",
    "html-minifier-terser": "^7.2.0",
    "playwright": "^1.61.0",
    "prettier": "^3.8.1",
    "terser": "^5.44.1",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.553.0",
    "motion": "^12.23.24",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.18",
    "zod": "^4.1.12"
  },
  "overrides": {
    "tmp": "0.2.7",
    "js-yaml": "^4.2.0",
    "uuid": "^11.1.1"
  }
}
