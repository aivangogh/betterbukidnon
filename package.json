{
  "name": "betterbukidnon-web",
  "version": "2.0.0",
  "description": "BetterBukidnon.org - volunteer civic portal for the Province of Bukidnon",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "pnpm web:dev",
    "build": "pnpm web:build",
    "build:major": "pnpm version:major && pnpm build",
    "build:minor": "pnpm version:minor && pnpm build",
    "serve": "pnpm web:dev",
    "serve:dist": "cd apps/web/dist/client && python3 -m http.server 8080",
    "version:major": "tsx scripts/bump-version.ts major",
    "version:minor": "tsx scripts/bump-version.ts minor",
    "version:patch": "tsx scripts/bump-version.ts patch",
    "version:check": "tsx scripts/bump-version.ts",
    "chrome": "tsx scripts/sync-chrome.ts",
    "chrome:check": "tsx scripts/sync-chrome.ts --check",
    "test": "playwright test",
    "test:chrome": "playwright test --project=chrome",
    "test:report": "playwright show-report",
    "screenshots:mobile": "node scripts/mobile-screenshots.mjs",
    "lighthouse": "lhci autorun",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "web:dev": "cd apps/web && vp dev",
    "web:build": "cd apps/web && vp build && cd ../.. && tsx scripts/generate-seo-files.ts && tsx scripts/generate-web-sw.ts",
    "web:preview": "cd apps/web && vp preview",
    "web:typecheck": "pnpm web:messages && vp check --no-fmt --no-lint apps/web",
    "web:check": "pnpm web:messages && vp check apps/web",
    "web:test": "pnpm web:messages && cd apps/web && vp test run",
    "package": "bash scripts/package-cpanel.sh --build",
    "package:only": "bash scripts/package-cpanel.sh",
    "web:messages": "tsx scripts/compile-messages.ts",
    "seo:check": "tsx scripts/check-seo.ts"
  },
  "keywords": [
    "bukidnon",
    "northern-mindanao",
    "province",
    "government",
    "lgu"
  ],
  "author": "BetterBukidnon contributors",
  "contributors": [
    "Ramon Logan Jr. (original BetterSolano template)"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Better-Bukidnon/betterbukidnon.git"
  },
  "homepage": "https://betterbukidnon.org",
  "license": "MIT",
  "devDependencies": {
    "@babel/cli": "^7.23.9",
    "@babel/core": "^7.29.6",
    "@babel/preset-env": "^7.23.9",
    "@inlang/plugin-message-format": "^4.6.0",
    "@lhci/cli": "^0.15.1",
    "@mdx-js/rollup": "^3.1.1",
    "@playwright/test": "^1.61.0",
    "@tailwindcss/vite": "^4.1.18",
    "@types/leaflet": "^1.9.22",
    "@types/mdx": "^2.0.14",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "clean-css-cli": "^5.6.3",
    "core-js": "^3.40.0",
    "html-minifier-terser": "^7.2.0",
    "playwright": "^1.61.0",
    "prettier": "^3.8.1",
    "remark-frontmatter": "^5.0.0",
    "remark-mdx-frontmatter": "^6.0.0",
    "terser": "^5.44.1",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "workbox-build": "^7.4.1",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@inlang/paraglide-js": "^3.2.2",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.5",
    "bootstrap-icons": "^1.13.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "lottie-web": "^5.13.0",
    "motion": "^12.23.24",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.18",
    "zod": "^4.1.12"
  },
  "overrides": {
    "tmp": "0.2.7",
    "js-yaml": "^4.2.0",
    "uuid": "^11.1.1"
  }
}
